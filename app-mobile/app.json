{
  "expo": {
    "name": "GoTrack",
    "slug": "app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0F0C",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.gotrack.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoTrack usa tus fotos para que elijas tu avatar de perfil.",
          "cameraPermission": "GoTrack accede a la cámara para tu avatar de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b31c5a74-9a52-4599-b04e-92c70d768e54"
      }
    }
  }
}
